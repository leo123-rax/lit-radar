# secrets
.env
.env.*
!.env.example

# runtime data: the SQLite database, its WAL/SHM side files, compressed snapshots, the HTTP cache
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.zst
data/*
!data/.gitkeep
.cache/

# generated outputs that are not the product
# (digests/*.md ARE tracked on purpose: they are the product. They reveal your watchlist when the
#  repository is public; see README "Security and privacy".)
digests/*.json
digests/_work/
site/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# os / editors / local agent worktrees
.DS_Store
.idea/
.vscode/
.claude/
