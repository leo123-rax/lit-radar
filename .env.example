# Copy this file to .env and fill in what you have. .env is git-ignored; never commit it.
# Every key here is OPTIONAL. The pipeline runs with none of them; keys only lift rate limits
# or switch on optional features.

# ---- identity for "polite pool" APIs (free; strongly recommended) ----------------------------
# Sent as mailto= to OpenAlex, Crossref and Unpaywall and in the User-Agent to every API.
LITRADAR_CONTACT_EMAIL=you@example.com

# ---- free API keys that raise rate limits ---------------------------------------------------
NCBI_API_KEY=                 # https://account.ncbi.nlm.nih.gov/settings/   (E-utilities: 3 -> 10 requests/s)
SEMANTIC_SCHOLAR_API_KEY=     # https://www.semanticscholar.org/product/api#api-key-form
OPENALEX_API_KEY=             # only for the paid tier; the free tier just needs the email above
ALTMETRIC_API_KEY=            # optional; researcher keys are granted on request

# ---- optional LLM ranking of the week's abstracts -------------------------------------------
ANTHROPIC_API_KEY=
LITRADAR_LLM_MODEL=claude-opus-5-5   # see docs/DESIGN.md for the cost table and cheaper options

# ---- optional delivery ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=                    # comma-separated
SLACK_WEBHOOK_URL=

# ---- personal publisher logins (reserved; NOT read by the pipeline) --------------------------
# A personal reading subscription does not grant automated download or text-mining rights, so
# the pipeline never logs in anywhere. These slots exist only for a fork owner who holds an
# institutional text-and-data-mining licence and writes their own authenticated fetcher.
# Read docs/LEGAL.md before putting anything here.
# PUBLISHER_NATURE_USER=
# PUBLISHER_NATURE_PASSWORD=
# PUBLISHER_SCIENCE_USER=
# PUBLISHER_SCIENCE_PASSWORD=
