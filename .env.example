# Copy this file to .env and fill in what you have. .env is git-ignored: never commit it and never paste
# it into an issue. Every value here is OPTIONAL. The pipeline runs with none of them; keys only lift rate
# limits or switch on optional features. On GitHub Actions the same names go under
# Settings -> Secrets and variables -> Actions (as secrets), never into YAML or the repository.
#
# This file holds machine credentials for public APIs that the pipeline calls. It never holds a personal
# login to a publisher website (see the note at the bottom and docs/LEGAL.md).

# ---- identity for "polite pool" APIs (free; strongly recommended) ----------------------------
# Sent as mailto= to OpenAlex, Crossref and Unpaywall and in the User-Agent of every request.
# SEC EDGAR 8-K feeds are skipped entirely while this is empty (the SEC requires a contact).
LITRADAR_CONTACT_EMAIL=you@example.com

# ---- free API keys that raise rate limits or unlock a source -----------------------------------
# OpenAlex: the key is free but effectively REQUIRED. Anonymous traffic shares a tiny per-IP daily
# budget that runs out within minutes of a weekly pull; a key gives your account its own free daily
# budget and a higher request rate. https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=
NCBI_API_KEY=                 # https://account.ncbi.nlm.nih.gov/settings/   E-utilities 3 -> 10 requests/s (SRA and GEO census)
OPENFDA_API_KEY=              # https://open.fda.gov/apis/authentication/   1,000 requests/day per IP -> 120,000/day per key (510(k), PMA)
SEMANTIC_SCHOLAR_API_KEY=     # https://www.semanticscholar.org/product/api#api-key-form   1 request/s with a key (citation enrichment)
ALTMETRIC_API_KEY=            # reserved; the free researcher tier is non-commercial only, a commercial operator needs a contract

# ---- optional LLM ranking of the week's shortlist ----------------------------------------------
# Pay-as-you-go. Set a spend limit on the provider's billing page before enabling --llm.
ANTHROPIC_API_KEY=
# LITRADAR_LLM_MODEL=         # uncomment to override the default model in litradar/config.py; the per-model
#                             # cost table is in litradar/rank/llm.py. Leave commented rather than empty.

# ---- optional delivery -------------------------------------------------------------------------
# Use an app-specific SMTP password, never a mailbox password. The Slack webhook URL is itself a
# credential: anyone who holds it can post to the channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=radar@example.com
DIGEST_TO=                    # comma-separated
SLACK_WEBHOOK_URL=

# ---- optional path overrides (defaults are relative to the repository) -------------------------
# LITRADAR_DB=data/radar.sqlite
# LITRADAR_CACHE_DIR=.cache
# LITRADAR_OUT_DIR=digests
# LITRADAR_CONFIG_DIR=config  # point at a private overlay to keep a personal watchlist out of a public fork

# ---- publisher logins: none --------------------------------------------------------------------
# Personal subscription logins never belong in this file. Publisher website terms (for example Springer
# Nature's Website Terms) allow access only through a normal web browser and forbid sharing login details,
# and a reading subscription grants no automated-download or text-mining rights. See docs/LEGAL.md.
