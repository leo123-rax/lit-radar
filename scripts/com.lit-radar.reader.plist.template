<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/reader_schedule.sh, which fills every placeholder below with an absolute
     path discovered on the machine, so this template itself holds no personal path. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@LABEL@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@@SCRIPT@@</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@@REPO@@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LITRADAR_READER_PYTHON</key>
    <string>@@PYTHON@@</string>
    <key>PATH</key>
    <string>@@PATH@@</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>@@HOUR@@</integer>
    <key>Minute</key>
    <integer>@@MINUTE@@</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>@@LOG@@</string>
  <key>StandardErrorPath</key>
  <string>@@LOG@@</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
