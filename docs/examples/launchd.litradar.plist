<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS scheduling example. Copy to ~/Library/LaunchAgents/litradar.weekly.plist, edit the two paths,
     then: launchctl load ~/Library/LaunchAgents/litradar.weekly.plist
     Runs Mondays at 07:30 local time; logs land next to the repo. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>litradar.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /PATH/TO/lit-radar &amp;&amp; .venv/bin/python -m litradar run --days 7 --email</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/PATH/TO/lit-radar/digests/_work/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/lit-radar/digests/_work/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
